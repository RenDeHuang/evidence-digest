{
  "name": "evidence-digest-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence Digest email backend: Cloudflare Worker + D1 + Cron Trigger.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply evidence-digest-db --local",
    "migrate:remote": "wrangler d1 migrations apply evidence-digest-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
